% ---------------------------------------------------------------
% Boxes. Usage: \begin{simple}[optional title] ... \end{simple}
% simple   : plain-words explanation of a concept
% keyfact  : a number or fact to remember for the viva
% tried    : one attempt; use \what{}, \why{}, \result{}, \decision{} inside
% lesson   : what we learned
% warn     : a common mistake / honest caveat
% viva     : a likely question with its answer; use \q{} and \ans{}
% analogy  : an everyday comparison
% ---------------------------------------------------------------
\tcbset{tmbase/.style={enhanced,breakable,boxrule=0.6pt,arc=2pt,left=6pt,right=6pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\small,before skip=0.7em,after skip=0.7em}}
\newtcolorbox{simple}[1][In simple words]{tmbase,colback=tmlight,colframe=tmblue,title={#1}}
\newtcolorbox{keyfact}[1][Remember]{tmbase,colback=tmgreenl,colframe=tmgreen,title={#1}}
\newtcolorbox{tried}[1][What we tried]{tmbase,colback=tmorangel,colframe=tmorange,title={#1}}
\newtcolorbox{lesson}[1][Lesson]{tmbase,colback=tmpurplel,colframe=tmpurple,title={#1}}
\newtcolorbox{warn}[1][Careful]{tmbase,colback=tmredl,colframe=tmred,title={#1}}
\newtcolorbox{viva}[1][Viva question]{tmbase,colback=white,colframe=tmblue!70,title={#1}}
\newtcolorbox{analogy}[1][Everyday comparison]{tmbase,colback=tmgreyl,colframe=tmgrey,title={#1}}

\newcommand{\what}[1]{\textbf{What:} #1\par}
\newcommand{\why}[1]{\textbf{Why:} #1\par}
\newcommand{\result}[1]{\textbf{Result:} #1\par}
\newcommand{\decision}[1]{\textbf{Decision:} #1\par}
\newcommand{\q}[1]{\textbf{Q: }#1\par}
\newcommand{\ans}[1]{\textbf{A: }#1\par}

% Small helpers
\newcommand{\file}[1]{\texttt{\detokenize{#1}}}
\newcommand{\term}[1]{\textbf{\color{tmblue}#1}}
\newcommand{\num}[1]{\textbf{#1}}

